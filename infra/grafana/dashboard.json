{
  "title": "Precios Tandil — API",
  "uid": "precios-tandil-api",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latencia API p95 (s)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(api_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RPS por ruta",
      "targets": [
        {
          "expr": "sum(rate(api_http_request_duration_seconds_count[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duración de corridas de ingesta (worker, logs)",
      "description": "Fuente: log event=run.finished duration_ms (Loki).",
      "targets": [
        {
          "expr": "sum(increase(precios_worker_run_duration_seconds_sum[1d]))",
          "legendFormat": "total"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SKUs capturados / rechazados (24h)",
      "description": "Fuente: run_report vía Postgres datasource o pushgateway del worker.",
      "targets": [
        { "expr": "increase(precios_skus_captured_total[24h])" },
        { "expr": "increase(precios_skus_rejected_total[24h])" }
      ],
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    }
  ]
}
