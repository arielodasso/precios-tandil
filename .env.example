DATABASE_URL=postgres://precios:precios@localhost:5432/precios
REDIS_URL=redis://localhost:6379
PORT=3001
NODE_ENV=development
ADMIN_TOKEN_DEV=dev-token
PROXY_POOL_URL=
SCRAPER_WINDOW_ART=00:00-06:00

# --- Google Analytics 4 (Data API) — dashboard /admin/sigmatecnologias ---
# Tag GA4 inyectado en el layout raíz (apps/web/src/app/layout.tsx). Es público.
NEXT_PUBLIC_GA_ID=G-7V77W8GP1C
# Property ID numérico (GA4 → Admin → Configuración de propiedad).
GA_PROPERTY_ID=
# Service account con acceso "Lector" a la propiedad; Data API habilitada en GCP.
GA_CLIENT_EMAIL=
# Clave privada del service account. Los saltos de línea deben ir escapados (\n).
GA_PRIVATE_KEY=

# --- Comercios registrados (bloque del panel /admin/tandilalerta) ---
# Base del sitio público de comercios. Se lee la ficha pública y se cachea 5 min.
MERCHANTS_SITE_URL=https://preciostandil.com
# Planes que habilitan la sección de ofertas del comercio (separados por coma).
MERCHANTS_OFFERS_PLANS=destacada

